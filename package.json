{
  "name": "pi-cliproxyapi-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "Bundles the CLIProxyAPI provider pi-cliproxyapi-provider (github.com/0xRichardH/pi-cliproxyapi-provider) into oh-my-pi-extensions, without loading it twice",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cliproxyapi"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "pi-cliproxyapi-provider": "^0.16.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.19.19",
    "typebox": "1.3.27",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
